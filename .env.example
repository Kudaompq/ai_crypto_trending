POSTGRES_USER=crypto_trending
POSTGRES_PASSWORD=replace_with_a_url_safe_password
POSTGRES_DB=crypto_trending
POSTGRES_PORT=5432
WATCHLIST_DATABASE_URL=postgres://crypto_trending:replace_with_a_url_safe_password@127.0.0.1:5432/crypto_trending?sslmode=disable

# Optional AI market analysis chat provider (OpenAI-compatible Chat Completions API)
# AI_CHAT_ENDPOINT accepts a base URL (for example https://api.deepseek.com or https://api.openai.com/v1)
# or a complete URL ending in /chat/completions.
AI_CHAT_ENDPOINT=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_TIMEOUT=20s

# Optional hourly Watchlist analysis. Runs only when both this flag and the AI provider are configured.
SCHEDULED_ANALYSIS_ENABLED=false
SCHEDULED_ANALYSIS_CONCURRENCY=4
SCHEDULED_ANALYSIS_SYMBOL_TIMEOUT=2m
SCHEDULED_ANALYSIS_MAX_DURATION=50m

# Optional server-side WeCom group bot webhook. Keep the real URL out of source control.
WECOM_WEBHOOK_URL=
WECOM_TIMEOUT=10s
